# Copy this file to .env for local development. Never commit the real .env.

APP_ENV=development
APP_BASE_URL=http://localhost:8080
API_BASE_URL=http://localhost:8000

POSTGRES_DB=memora
POSTGRES_USER=memora
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://memora:change-me@localhost:5432/memora
SESSION_SECRET=replace-with-a-long-random-value
SESSION_TTL_SECONDS=1209600
LOG_LEVEL=INFO

# Local-only seed accounts. Override every password before a public deployment.
SEED_USER_1_EMAIL=alex@memora.local
SEED_USER_1_DISPLAY_NAME=Alex
SEED_USER_1_PASSWORD=memora-local-alex
SEED_USER_2_EMAIL=blair@memora.local
SEED_USER_2_DISPLAY_NAME=Blair
SEED_USER_2_PASSWORD=memora-local-blair
SEED_USER_3_EMAIL=casey@memora.local
SEED_USER_3_DISPLAY_NAME=Casey
SEED_USER_3_PASSWORD=memora-local-casey
SEED_USER_4_EMAIL=devon@memora.local
SEED_USER_4_DISPLAY_NAME=Devon
SEED_USER_4_PASSWORD=memora-local-devon

# Local defaults use HTTP on ports 8080/8443. In production, set a real domain
# such as memora.example.com and bind HTTP_PORT/HTTPS_PORT to 80/443.
CADDY_SITE_ADDRESS=http://localhost
HTTP_PORT=8080
HTTPS_PORT=8443

# AI 配置仅供 API/worker 服务端读取，绝不能改成 NEXT_PUBLIC_ 变量。
#
# 最小启用步骤：
# 1. 复制本文件为 .env。
# 2. 把云雾专用低额度 Key 填入 AI_CHAT_API_KEY。
# 3. 重建服务：docker compose up --detach --build api worker
#
# gpt-5.6-terra 是当前模板的多模态质量/成本平衡模型，可处理文字与图片。
# 若账号没有该模型，请用 GET https://yunwu.ai/v1/models 返回的视觉模型 ID 替换。
AI_CHAT_BASE_URL=https://yunwu.ai/v1
AI_CHAT_API_KEY=
AI_CHAT_MODEL=gpt-5.6-terra
# Chatbot 菜单只暴露这里登记的模型；provider_model 仍通过统一兼容端口调用。
AI_MODEL_REGISTRY_JSON=[{"id":"gpt","label":"GPT 5.6","provider_model":"gpt-5.6-terra","capabilities":["chat","vision","web_search","tools"],"default":true},{"id":"claude","label":"Claude Sonnet 4.6","provider_model":"claude-sonnet-4-6","capabilities":["chat","vision","web_search","tools"]},{"id":"gemini","label":"Gemini 3.1 Pro","provider_model":"gemini-3.1-pro-preview","capabilities":["chat","vision","web_search","tools"]}]

# 语义检索是可选能力。若同一个云雾 Key 同时拥有 embedding 权限，可把
# 同一个 Key 再填入 AI_EMBEDDING_API_KEY；这里刻意不从聊天配置隐式继承。
# 若账号没有 text-embedding-3-small，请换成 /v1/models 返回的 embedding 模型。
AI_EMBEDDING_BASE_URL=https://yunwu.ai/v1
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=text-embedding-3-small

# API/worker 访问外部模型时使用的容器 DNS。可按部署网络覆盖；默认值用于
# 避免部分 macOS/Colima 环境没有向 Docker 注入上游 DNS。
DOCKER_DNS_PRIMARY=223.5.5.5
DOCKER_DNS_SECONDARY=1.1.1.1

# If your host machine reaches the AI provider through a local proxy, expose
# that proxy to Docker containers. Colima commonly uses the host gateway
# 192.168.5.2; leave these blank when containers can reach the provider directly.
DOCKER_HTTP_PROXY=
DOCKER_HTTPS_PROXY=
DOCKER_ALL_PROXY=
DOCKER_NO_PROXY=localhost,127.0.0.1,db,api,web,worker,proxy

# 供应商边界和成本保护。
AI_REQUEST_TIMEOUT_SECONDS=180
# 联网搜索复用聊天模型的 Key 和 Base URL，但通过独立端口与独立模型调用 Responses API。
# 默认自动判断；设为 false 可在不影响普通聊天和图片理解的情况下关闭联网。
AI_WEB_SEARCH_ENABLED=true
# 深度聊天模型可能不适合承担检索。该模型只负责 Responses API 联网，并不会替代聊天模型。
AI_WEB_SEARCH_MODEL=gpt-4.1-mini
AI_WEB_SEARCH_TIMEOUT_SECONDS=90
AI_CHAT_MAX_OUTPUT_TOKENS=2400
AI_EMBEDDING_MAX_ATTEMPTS=5
AI_JOB_RETRY_BASE_SECONDS=15
# 当前只作为运维预算说明；应用不会因为达到该值而静默停止写入。
AI_MONTHLY_BUDGET_CNY=1000
