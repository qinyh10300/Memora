# Run `make setup` to create a mode-0600 .env. Never commit or broaden permissions on it.

APP_ENV=development
APP_BASE_URL=http://localhost:8080
API_BASE_URL=http://localhost:8000

POSTGRES_DB=memora
POSTGRES_USER=memora
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://memora:change-me@localhost:5432/memora
SESSION_SECRET=replace-with-a-long-random-value
SESSION_TTL_SECONDS=1209600
# 邮箱验证码默认关闭。启用后必须配置 SMTP；验证码不会写入日志或 API 响应。
EMAIL_VERIFICATION_ENABLED=false
EMAIL_VERIFICATION_CODE_TTL_SECONDS=600
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_FROM_EMAIL=
EMAIL_SMTP_STARTTLS=true
EMAIL_SMTP_USE_SSL=false
EMAIL_SMTP_TIMEOUT_SECONDS=10
LOG_LEVEL=INFO
METRICS_ENABLED=false
# 启用 metrics 时必须使用独立的 32+ 字符 Bearer token；不要复用登录或 AI 密钥。
METRICS_TOKEN=
# 可选：只接收脱敏运行事件的 HTTP 接收端。未配置时保留本地结构化日志。
OBSERVABILITY_SINK_URL=
OBSERVABILITY_SINK_TOKEN=
OBSERVABILITY_SINK_TIMEOUT_SECONDS=2

# 仅本地验收需要；生产环境禁止启用，也不会默认创建任何账号或工作区。
SEED_DEVELOPMENT_DATA_ENABLED=false
# 仅在 development + seed 同时启用时生效；允许从登录弹窗点击 seed 账号直接进入。
DEVELOPMENT_QUICK_LOGIN_ENABLED=false

# Local-only seed accounts. Override every password before a public deployment.
SEED_USER_1_EMAIL=alex@memora.local
SEED_USER_1_DISPLAY_NAME=Alex
SEED_USER_1_PASSWORD=memora-local-alex
SEED_USER_2_EMAIL=blair@memora.local
SEED_USER_2_DISPLAY_NAME=Blair
SEED_USER_2_PASSWORD=memora-local-blair
SEED_USER_3_EMAIL=casey@memora.local
SEED_USER_3_DISPLAY_NAME=Casey
SEED_USER_3_PASSWORD=memora-local-casey
SEED_USER_4_EMAIL=devon@memora.local
SEED_USER_4_DISPLAY_NAME=Devon
SEED_USER_4_PASSWORD=memora-local-devon

# Local defaults use HTTP on ports 8080/8443. In production, set a real domain
# such as memora.example.com and bind HTTP_PORT/HTTPS_PORT to 80/443.
CADDY_SITE_ADDRESS=http://localhost
HTTP_PORT=127.0.0.1:8080
HTTPS_PORT=127.0.0.1:8443

# AI 配置仅供 API/worker 服务端读取，绝不能改成 NEXT_PUBLIC_ 变量。
#
# 最小启用步骤：
# 1. 复制本文件为 .env。
# 2. 把云雾专用低额度 Key 填入 AI_CHAT_API_KEY。
# 3. 重建服务：docker compose up --detach --build api worker
#
# gpt-5.6-terra 是当前模板的多模态质量/成本平衡模型，可处理文字与图片。
# 若账号没有该模型，请用 GET https://yunwu.ai/v1/models 返回的视觉模型 ID 替换。
AI_CHAT_BASE_URL=https://yunwu.ai/v1
AI_CHAT_API_KEY=
AI_CHAT_MODEL=gpt-5.6-terra
# Chatbot 菜单只暴露这里登记的模型；provider_model 仍通过统一兼容端口调用。
AI_MODEL_REGISTRY_JSON=[{"id":"claude-haiku","label":"Claude 4.5 Haiku","provider_model":"claude-4.5-haiku","provider_family":"claude","capabilities":["chat","vision","web_search","tools"],"cost_tier":"economy","priority":10,"description":"轻量快速，适合高并发","min_plan":"PLUS"},{"id":"gpt-luna","label":"GPT 5.6 Luna","provider_model":"gpt-5.6-luna","provider_family":"gpt","capabilities":["chat","vision","web_search","tools"],"cost_tier":"economy","priority":20,"description":"快速经济，1M 长上下文","min_plan":"PLUS","fallback_ids":["claude-haiku"],"default":true},{"id":"gemini-flash","label":"Gemini 3 Flash","provider_model":"gemini-3-flash","provider_family":"gemini","capabilities":["chat","vision","web_search","tools"],"cost_tier":"balanced","priority":30,"description":"极速多模态，支持思考","min_plan":"PRO"},{"id":"gpt-terra","label":"GPT 5.6 Terra","provider_model":"gpt-5.6-terra","provider_family":"gpt","capabilities":["chat","vision","web_search","tools"],"cost_tier":"balanced","priority":40,"description":"旗舰级能力，成本减半","min_plan":"PRO","fallback_ids":["gpt-luna"]},{"id":"claude-sonnet","label":"Claude 5 Sonnet","provider_model":"claude-5-sonnet","provider_family":"claude","capabilities":["chat","vision","web_search","tools"],"cost_tier":"balanced","priority":50,"description":"平衡速度与质量的日常首选","min_plan":"PRO","badges":["NEW"]},{"id":"gemini-pro","label":"Gemini 3.1 Pro","provider_model":"gemini-3.1-pro","provider_family":"gemini","capabilities":["chat","vision","web_search","tools"],"cost_tier":"premium","priority":60,"description":"多模态旗舰，支持思考","min_plan":"PRO"},{"id":"gpt-sol","label":"GPT 5.6 Sol","provider_model":"gpt-5.6-sol","provider_family":"gpt","capabilities":["chat","vision","web_search","tools"],"cost_tier":"premium","priority":70,"description":"OpenAI 最新旗舰，1M 长上下文","min_plan":"ULTRA","badges":["BEST"]},{"id":"claude-opus","label":"Claude 5 Opus","provider_model":"claude-5-opus","provider_family":"claude","capabilities":["chat","vision","web_search","tools"],"cost_tier":"premium","priority":80,"description":"最新旗舰，最强推理与写作","min_plan":"ULTRA","badges":["BEST","NEW"]}]
AI_IMAGE_BASE_URL=https://yunwu.ai/v1
AI_IMAGE_API_KEY=
AI_IMAGE_MODEL_REGISTRY_JSON=[{"id":"gpt-image-2","provider_model":"gpt-image-2"},{"id":"nano-banana","provider_model":"nano-banana"},{"id":"nano-banana-2","provider_model":"nano-banana-2"},{"id":"nano-banana-pro","provider_model":"nano-banana-pro"}]
AI_IMAGE_REQUEST_TIMEOUT_SECONDS=180
AI_IMAGE_MAX_ATTEMPTS=3
AI_VISUALS_ENABLED=true
TEAM_INTELLIGENCE_ENABLED=true
AI_TASK_CREDIT_COSTS_JSON={"report":20,"alignment":15,"structured_visual":30,"gpt-image-2":120,"nano-banana":60,"nano-banana-2":90,"nano-banana-pro":160}

# 语义检索是可选能力。若同一个云雾 Key 同时拥有 embedding 权限，可把
# 同一个 Key 再填入 AI_EMBEDDING_API_KEY；这里刻意不从聊天配置隐式继承。
# 若账号没有 text-embedding-3-small，请换成 /v1/models 返回的 embedding 模型。
AI_EMBEDDING_BASE_URL=https://yunwu.ai/v1
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=text-embedding-3-small

# Chatbot 语音输入使用独立的转写配置，不向浏览器暴露 Key，也不隐式复用聊天 Key。
# 供应商必须兼容 POST /v1/audio/transcriptions；不配置时文字聊天仍正常可用。
AI_SPEECH_BASE_URL=https://yunwu.ai/v1
AI_SPEECH_API_KEY=
AI_SPEECH_MODEL=gpt-4o-mini-transcribe
# 留空时由转写模型自动识别语言；固定中文可设为 zh。
AI_SPEECH_LANGUAGE=
AI_SPEECH_TIMEOUT_SECONDS=60
AI_SPEECH_MAX_AUDIO_BYTES=10485760

# API/worker 访问外部模型时使用的容器 DNS。可按部署网络覆盖；默认值用于
# 避免部分 macOS/Colima 环境没有向 Docker 注入上游 DNS。
DOCKER_DNS_PRIMARY=223.5.5.5
DOCKER_DNS_SECONDARY=1.1.1.1

# If your host machine reaches the AI provider through a local proxy, expose
# that proxy to Docker containers. Colima commonly uses the host gateway
# 192.168.5.2; leave these blank when containers can reach the provider directly.
DOCKER_HTTP_PROXY=
DOCKER_HTTPS_PROXY=
DOCKER_ALL_PROXY=
DOCKER_NO_PROXY=localhost,127.0.0.1,db,api,web,worker,proxy,fake-ai

# 供应商边界和成本保护。
AI_REQUEST_TIMEOUT_SECONDS=180
# 联网搜索复用聊天模型的 Key 和 Base URL，但通过独立端口与独立模型调用 Responses API。
# 默认自动判断；设为 false 可在不影响普通聊天和图片理解的情况下关闭联网。
AI_WEB_SEARCH_ENABLED=true
# 深度聊天模型可能不适合承担检索。该模型只负责 Responses API 联网，并不会替代聊天模型。
AI_WEB_SEARCH_MODEL=gpt-4.1-mini
AI_WEB_SEARCH_TIMEOUT_SECONDS=90
AI_CHAT_MAX_OUTPUT_TOKENS=2400
# 费用指标只采用运维人员明确配置的单百万 token 美元价格，不内置可能过期的供应商价格。
# 示例格式：{"model-id":{"input_usd_per_million":1.0,"output_usd_per_million":4.0}}
AI_MODEL_PRICING_JSON={}
AI_EMBEDDING_MAX_ATTEMPTS=5
AI_JOB_RETRY_BASE_SECONDS=15
# 当前只作为运维预算说明；应用不会因为达到该值而静默停止写入。
AI_MONTHLY_BUDGET_CNY=1000
