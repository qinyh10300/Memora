# Copy this file to .env for local development. Never commit the real .env.

APP_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

DATABASE_URL=postgresql+psycopg://memora:change-me@localhost:5432/memora
SESSION_SECRET=replace-with-a-long-random-value

# Server-side only. Never expose these through a NEXT_PUBLIC_ variable.
AI_CHAT_BASE_URL=https://yunwu.ai/v1
AI_CHAT_API_KEY=
AI_CHAT_MODEL=

# Keep embedding separate because the relay or future local deployment may use
# a different endpoint, key, or model.
AI_EMBEDDING_BASE_URL=https://yunwu.ai/v1
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=

AI_REQUEST_TIMEOUT_SECONDS=60
AI_MONTHLY_BUDGET_CNY=1000
